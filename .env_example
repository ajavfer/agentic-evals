# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Model used by YOUR agent under eval (examples/agent_demo.py reads this;
# cheaper/weaker is fine — you're evaluating it, not relying on it)
AGENT_MODEL=gemini-3.1-flash-lite

# Generic fallback model for anything that doesn't have a specific override
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM judge model for evaluators (evalkit.evals.judge_llm)
JUDGE_MODEL=gemini-3.5-flash-lite

# Model for the AgenticEvaluator meta-review (evalkit.agentic_evaluator) —
# use a stronger model here; it orchestrates judges and reads traces.
# Few calls per run, so a bigger model is affordable.
# Alternatives: gemini-3.6-flash or gemini-3.8-flash
AGENTIC_MODEL=gemini-3.5-flash-lite

# Local Phoenix server
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agent-tracer-adk

# Minimum seconds between model calls (free tier ~15 req/min)
LLM_MIN_INTERVAL_S=4.5
